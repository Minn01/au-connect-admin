# Required at build time: Next compiles this base path into the app.
NEXT_PUBLIC_BASE_PATH=/connect-admin

# Runtime settings for the production container in the main app's Compose stack.
DATABASE_URL=mongodb://mongo:27017/au-connect?directConnection=true
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_CONNECTION_STRING=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
JWT_SECRET=

# Optional locally, but recommended on the production VM for canonical OAuth,
# authentication redirect, and invitation URLs.
# ADMIN_PUBLIC_URL=http://localhost:3000/connect-admin
ADMIN_PUBLIC_URL=https://life.au.edu/connect-admin

# Runtime URL used for links from the admin UI to the main application.
MAIN_APP_PATH=https://life.au.edu/connect
